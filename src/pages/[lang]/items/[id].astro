---
/** HTML fragment loaded into the item details panel (modules/item). One per language and catalog item. */
import type { InferGetStaticPropsType } from "astro";
import ItemPanel from "../../../modules/item/components/ItemPanel.astro";
import { listItemIds } from "../../../services/content/catalog";
import { LANGS } from "../../../services/i18n/config";

export const partial = true;

export async function getStaticPaths() {
	const ids = await listItemIds();
	return LANGS.flatMap((lang) => ids.map((id) => ({ params: { lang, id }, props: { lang, id } })));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { lang, id } = Astro.props;
---

<ItemPanel lang={lang} id={id} />
