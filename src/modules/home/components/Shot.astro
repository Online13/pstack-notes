---
/** A screenshot from the talk: tilted, opens in the lightbox, caption links to the talk. */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { TALK_URL } from "../../../services/content/sources";
import { homeMessages } from "../messages";
import type { Lang } from "../../../types/i18n";

interface Props {
	image: ImageMetadata;
	caption: string;
	lang: Lang;
	eager?: boolean;
}
const { image, caption, lang, eager = false } = Astro.props;
const ui = homeMessages(lang);
---

<figure class="shot">
	<button
		type="button"
		class="zoomable"
		data-lightbox
		data-full={image.src}
		data-caption={caption}
		data-source={TALK_URL}
		aria-label={ui.zoomImage}
	>
		<Image src={image} alt={caption} loading={eager ? "eager" : "lazy"} />
	</button>
	<figcaption>
		{caption} ·{" "}
		<a href={TALK_URL} target="_blank" rel="noopener">
			{ui.source} ↗
		</a>
	</figcaption>
</figure>
