---
/** A screenshot from the talk: tilted, opens in the lightbox, caption links to the talk. */
import type { ImageMetadata } from "astro";
import { Picture, getImage } from "astro:assets";
import { TALK_URL } from "../../../services/content/sources";
import { homeMessages } from "../messages";
import type { Lang } from "../../../types/i18n";

interface Props {
	image: ImageMetadata;
	caption: string;
	lang: Lang;
	eager?: boolean;
}
const { image, caption, lang, eager = false } = Astro.props;
const ui = homeMessages(lang);
/** Full-size WebP for the lightbox, so it never loads the PNG source. */
const full = await getImage({ src: image, format: "webp", quality: 90 });
---

<figure class="shot">
	<button
		type="button"
		class="zoomable"
		data-lightbox
		data-full={full.src}
		data-caption={caption}
		data-source={TALK_URL}
		aria-label={ui.zoomImage}
	>
		<Picture
			src={image}
			alt={caption}
			formats={["avif", "webp"]}
			widths={[image.width / 2, image.width]}
			sizes="(max-width: 760px) 100vw, 480px"
			quality={88}
			loading={eager ? "eager" : "lazy"}
			fetchpriority={eager ? "high" : undefined}
		/>
	</button>
	<figcaption>
		{caption} ·{" "}
		<a href={TALK_URL} target="_blank" rel="noopener">
			{ui.source} ↗
		</a>
	</figcaption>
</figure>
