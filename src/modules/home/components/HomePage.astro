---
/** Home page: a search over everything in pstack, and under it an index of pstack that its results replace. */
import BaseLayout from "../../../components/templates/BaseLayout.astro";
/* after BaseLayout: the module sheet comes after the shared ones in the cascade */
import "../assets/home.css";
import ItemModal from "../../item/components/ItemModal.astro";
import { listCallEdges, listItems } from "../../../services/content/catalog";
import { listLessons } from "../../../services/content/lessons";
import { listUseCaseGroups } from "../../../services/content/use-cases";
import { href } from "../../../services/i18n/config";
import { sharedMessages } from "../../../services/i18n/messages";
import { homeMessages } from "../messages";
import { searchText } from "../helpers/search-text";
import type { SearchEntry } from "../type";
import type { Lang } from "../../../types/i18n";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const h = homeMessages(lang);
const sections = sharedMessages(lang).sections;
const [items, groups, lessons, edges] = await Promise.all([
	listItems(lang),
	listUseCaseGroups(lang),
	listLessons(lang),
	listCallEdges(),
]);
const stripTags = (html: string) => html.replace(/<[^>]+>/g, "");

/** Everything the search can find: catalog items, then use cases, then notes. */
const entries: SearchEntry[] = [
	...items.map((i) => ({
		open: i.id,
		label: i.label,
		group: sections[3],
		meta: i.kindName,
		desc: i.desc,
		color: i.color,
		search: searchText(`${i.label} ${i.id} ${i.desc}`),
	})),
	...groups.flatMap((g) =>
		g.cases.map((c) => ({
			href: href(lang, "use-cases", `#case-${c.id}`),
			label: c.title,
			group: sections[2],
			meta: g.name,
			desc: c.when,
			color: "--k-step",
			search: searchText(
				`${c.title} ${c.when} ${c.blocks.map((b) => `${b.prompt ?? ""} ${b.note ?? ""}`).join(" ")}`,
			),
		})),
	),
	...lessons.map((l, k) => ({
		href: href(lang, "getting-started", `#gsl-${k}`),
		label: l.title,
		group: sections[1],
		meta: `${h.note} ${k + 1}`,
		desc: l.intro ? stripTags(l.intro) : l.short,
		color: "--k-step",
		search: searchText(`${l.title} ${l.short} ${l.intro ? stripTags(l.intro) : ""}`),
	})),
];

/** The index under the search: a few real entries per column, then a link to all of them. */
const SHOWN = 6;
const calls = new Map<string, number>();
for (const [, callee] of edges) calls.set(callee, (calls.get(callee) ?? 0) + 1);
const playbooks = items.filter((i) => i.kind === "pb");
const skills = items.filter((i) => i.kind === "sk").sort((a, b) => (calls.get(b.id) ?? 0) - (calls.get(a.id) ?? 0));
type Link = { label: string; href: string } | { label: string; open: string };
const columns: { title: string; links: Link[]; all: string; allHref: string }[] = [
	{
		title: h.index[0][0],
		links: lessons.map((l, k) => ({ label: l.short, href: href(lang, "getting-started", `#gsl-${k}`) })),
		all: h.index[0][1].replace("{n}", String(lessons.length)),
		allHref: href(lang, "getting-started"),
	},
	{
		title: h.index[1][0],
		links: groups.map((g) => ({ label: g.name, href: href(lang, "use-cases", `#group-${g.id}`) })),
		all: h.index[1][1].replace("{n}", String(groups.reduce((sum, g) => sum + g.cases.length, 0))),
		allHref: href(lang, "use-cases"),
	},
	{
		title: h.index[2][0],
		links: playbooks.map((i) => ({ label: i.label, open: i.id })),
		all: h.index[2][1].replace("{n}", String(playbooks.length)),
		allHref: href(lang, "api"),
	},
	{
		title: h.index[3][0],
		links: skills.map((i) => ({ label: i.label, open: i.id })),
		all: h.index[3][1].replace("{n}", String(skills.length)),
		allHref: href(lang, "api"),
	},
];
/** One case per group, from the first groups: its first command, shown as a tile at the bottom of the well. */
const TILES = 4;
const tiles = groups
	.flatMap((g) => {
		const c = g.cases.find((u) => u.blocks.some((b) => b.prompt !== undefined));
		const prompt = c?.blocks.find((b) => b.prompt !== undefined)?.prompt;
		return c && prompt !== undefined
			? [{ group: g.name, title: c.title, prompt, href: href(lang, "use-cases", `#case-${c.id}`) }]
			: [];
	})
	.slice(0, TILES);
---

<BaseLayout lang={lang} section="home" title={h.metaTitle} description={h.metaDesc}>
	<main class="home" id="search">
		<header class="hm-head">
			<div>
				<h1>{h.h1}</h1>
				<p>{h.sub}</p>
			</div>
			<a href={href(lang, "about")}>{h.about} →</a>
		</header>
		<section class="hm-well" data-search aria-label={h.searchLabel}>
			<div class="hm-bar">
				<div class="hm-field">
					<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
						<circle cx="11" cy="11" r="7"></circle>
						<path d="m20 20-4-4"></path>
					</svg>
					<input
						type="search"
						autocomplete="off"
						spellcheck="false"
						placeholder={h.search}
						aria-label={h.searchLabel}
						aria-controls="hmResults"
						aria-describedby="hmStatus"
						data-ideas={JSON.stringify(h.ideas)}
						data-site-search
					/>
				</div>
				<p
					class="hm-status"
					id="hmStatus"
					aria-live="polite"
					data-status
					data-one={h.count[0]}
					data-many={h.count[1]}
					data-empty={h.empty}
				></p>
			</div>
			<nav class="hm-index" aria-label={h.indexLabel}>
				{columns.map(({ title, links, all, allHref }) => (
					<div>
						<h2>{title}</h2>
						<ul>
							{links.slice(0, SHOWN).map((link) => (
								<li>
									{"open" in link ? (
										<button type="button" data-open={link.open}>
											{link.label}
										</button>
									) : (
										<a href={link.href}>{link.label}</a>
									)}
								</li>
							))}
						</ul>
						<a class="hm-all" href={allHref}>
							{all} →
						</a>
					</div>
				))}
			</nav>
			<div class="hm-tiles">
				<h2>{h.tilesTitle}</h2>
				<ul>
					{tiles.map((t) => (
						<li>
							<a href={t.href}>
								<span class="hm-tile-group">{t.group}</span>
								<b>{t.title}</b>
								<code>{t.prompt}</code>
							</a>
						</li>
					))}
				</ul>
			</div>
			<div class="hm-found" id="hmResults" data-results data-more={h.more} hidden></div>
		</section>
		<script id="search-data" type="application/json" set:html={JSON.stringify(entries).replace(/</g, "\\u003c")} />
	</main>
	<ItemModal slot="overlays" lang={lang} />
</BaseLayout>

<script>
	import { requireElement } from "../../../helpers/dom";
	import { initHomeSearch } from "../helpers/search";

	initHomeSearch(requireElement("[data-search]", HTMLElement));
</script>
