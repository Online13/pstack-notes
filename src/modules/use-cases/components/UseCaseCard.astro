---
/**
 * A situation: collapsed it shows title, cost and when to use it. Open it shows one block per thing you can type:
 * the command, what it is for, then what runs.
 */
import CostBar from "../../../components/atoms/CostBar.astro";
import Icon from "../../../components/atoms/Icon.astro";
import KindTag from "../../../components/atoms/KindTag.astro";
import CopyIcon from "../../../components/atoms/CopyIcon.astro";
import CaseStep from "./CaseStep.astro";
import { sharedMessages } from "../../../services/i18n/messages";
import { useCasesMessages } from "../messages";
import type { Lang } from "../../../types/i18n";
import type { UseCase } from "../../../types/content";

interface Props {
	useCase: UseCase;
	lang: Lang;
}
const { useCase: u, lang } = Astro.props;
const m = sharedMessages(lang);
const uc = useCasesMessages(lang);
---

<details class="case" id={`case-${u.id}`} data-case={u.id}>
	<summary>
		<Icon name="chevron" class="chev" width={2.2} />
		<span class="ct">{u.title}</span>
		<span class="cc">
			<CostBar cost={u.cost} lang={lang} /> {m.costLabels[u.cost]}
		</span>
		<span class="cw">{u.when}</span>
	</summary>
	<div class="cbody">
		{u.blocks.map((b) => (
			<section class="block">
				<div class="uhead">
					{b.item ? (
						<>
							<span class="ic" style={`--kind: var(${b.item.color})`}></span>
							<span class="un">{b.item.label}</span>
							<KindTag kind={b.item.kind} lang={lang} />
							<CostBar cost={b.item.cost} lang={lang} />
							{b.via && <span class="via">via /{b.via}</span>}
						</>
					) : (
						<>
							<span class="ic step"></span>
							<span class="un step">{b.text}</span>
						</>
					)}
				</div>
				{b.prompt && (
					<div class="try">
						<div class="lab">{m.typeThis}</div>
						<pre class="copyable" role="button" tabindex="0" title={m.copy.copy}>{b.prompt}<CopyIcon /></pre>
					</div>
				)}
				{b.note && <p class="unote">{b.note}</p>}
				{(b.item !== undefined || b.steps.length > 0) && (
					<div class="runs">
						<div class="lab">{uc.whatRuns}</div>
						{b.item && <p class="ud">{b.item.desc}</p>}
						{b.steps.length > 0 && (
							<ol class="steps">
								{b.steps.map((s) => (
									<CaseStep node={s} lang={lang} />
								))}
							</ol>
						)}
					</div>
				)}
			</section>
		))}
	</div>
</details>
