---
/** Use cases page: the situations, grouped. */
import BaseLayout from "../../../components/templates/BaseLayout.astro";
/* after BaseLayout: the module sheet comes after the shared ones in the cascade */
import "../assets/use-cases.css";
import ItemModal from "../../item/components/ItemModal.astro";
import UseCaseCard from "./UseCaseCard.astro";
import { listUseCaseGroups } from "../../../services/content/use-cases";
import { useCasesMessages } from "../messages";
import type { Lang } from "../../../types/i18n";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const m = useCasesMessages(lang);
const groups = await listUseCaseGroups(lang);
---

<BaseLayout lang={lang} section="use-cases" title={m.ucTitle} description={m.ucIntro}>
	<main class="uc">
		<div class="sec-intro">
			<h1>{m.ucTitle}</h1>
			<p>{m.ucIntro}</p>
		</div>
		<div class="uclist">
			{groups.map((group) => (
				<div class="ucgroup" id={`group-${group.id}`}>
					<h3>{group.name}</h3>
					<div class="cases">
						{group.cases.map((u) => (
							<UseCaseCard useCase={u} lang={lang} />
						))}
					</div>
				</div>
			))}
		</div>
	</main>
	<ItemModal slot="overlays" lang={lang} />
</BaseLayout>

<script>
	import { initUseCases } from "../helpers/open-cases";

	initUseCases();
</script>
