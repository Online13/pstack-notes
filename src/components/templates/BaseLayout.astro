---
/**
 * Page shell: head, header, footer, and the shared overlays (image preview, tooltip).
 * Pages put their own overlays (e.g. the item details) in the "overlays" slot.
 */
import "../../assets/styles/global.css";
import Header from "../organisms/Header.astro";
import Footer from "../organisms/Footer.astro";
import Lightbox from "../organisms/Lightbox.astro";
import Tooltip from "../organisms/Tooltip.astro";
import HeadIcons from "../atoms/HeadIcons.astro";
import { THEME_STORAGE_KEY } from "../../helpers/theme";
import { sharedMessages } from "../../services/i18n/messages";
import { getPageSeo } from "../../services/seo/seo";
import type { Lang, Section } from "../../types/i18n";

interface Props {
	lang: Lang;
	section: Section;
	/** Page name, without the site name. */
	title?: string;
	description: string;
}
const { lang, section, title, description } = Astro.props;
const m = sharedMessages(lang);
const seo = getPageSeo({ lang, section, title, description });
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{seo.title}</title>
		{seo.meta.map((tag) => (
			<meta {...tag} />
		))}
		{seo.links.map((link) => (
			<link {...link} />
		))}
		<script type="application/ld+json" set:html={seo.jsonLd} />
		<HeadIcons />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
		/>
		<!-- Applies the saved theme before the first paint (helpers/theme.ts saves it). "system" leaves data-theme unset. -->
		<script is:inline define:vars={{ key: THEME_STORAGE_KEY }}>
			let pref = "system";
			try {
				const t = localStorage.getItem(key);
				if (t === "light" || t === "dark") pref = t;
			} catch {
				/* storage unavailable: keep "system" */
			}
			const root = document.documentElement;
			root.dataset.themePref = pref;
			if (pref !== "system") root.dataset.theme = pref;
		</script>
	</head>
	<body data-section={section} data-copy-label={m.copy.copy} data-copied-label={m.copy.copied}>
		<div class="wrap">
			<Header lang={lang} section={section} />
			<slot />
			<Footer lang={lang} />
		</div>

		<slot name="overlays" />
		<Lightbox lang={lang} />
		<Tooltip />
	</body>
</html>
