---
/** Stroke icons (24×24). */
const PATHS = {
	book: '<path d="M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3z"/><path d="M5 17a3 3 0 0 1 3-3h11M9 8h6"/>',
	menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
	chevron: '<path d="m6 9 6 6 6-6"/>',
	check: '<path d="M5 12.5 10 17 19 7"/>',
	copy: '<rect x="9" y="9" width="11" height="11" rx="2.5"/><path d="M5 15V6.5A2.5 2.5 0 0 1 7.5 4H15"/>',
	table: '<rect x="3" y="4" width="18" height="16" rx="3"/><path d="M3 10h18M3 15h18M9 10v10"/>',
	graph: '<circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="8" r="2.5"/><circle cx="9" cy="18" r="2.5"/><path d="M8.3 7l7.4.8M7 8.3l1.4 7.3M16.4 10l-5.6 6.2"/>',
	system: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>',
	light: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
	dark: '<path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/>',
	curve: '<path d="M3 20h18M5 16c3-8 7-11 14-12"/>',
	up: '<path d="M12 19V5M6 11l6-6 6 6"/>',
	done: '<path d="M5 12l4 4 10-10"/>',
	doc: '<rect x="4" y="4" width="16" height="16" rx="3"/><path d="M8 9h8M8 13h8M8 17h5"/>',
	search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/>',
} as const;
/** Brand marks drawn as filled shapes instead of strokes. */
const FILLED = {
	github:
		'<path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z"/>',
} as const;
type StrokeName = keyof typeof PATHS;
type FilledName = keyof typeof FILLED;
export type IconName = StrokeName | FilledName;

function isFilled(name: IconName): name is FilledName {
	return name in FILLED;
}

interface Props {
	name: IconName;
	class?: string;
	/** Stroke width; the original icons use 2, the check mark 2.4. */
	width?: number;
}
const { name, class: className, width = 2 } = Astro.props;
---

{isFilled(name) ? (
	<svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={FILLED[name]} />
) : (
	<svg
		class={className}
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width={width}
		stroke-linecap="round"
		stroke-linejoin={
			name === "book" || name === "check" || name === "copy" || name === "chevron" ? "round" : undefined
		}
		aria-hidden="true"
		set:html={PATHS[name]}
	/>
)}
